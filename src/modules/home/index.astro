---
// Home: brand name, search, top tasks from brand.json, and recent changes. No illustration.
import { brand } from "virtual:brand-hub";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import ChangelogEntry from "../../components/ChangelogEntry.astro";
import Icon from "../../components/Icon.astro";
import IconTile from "../../components/IconTile.astro";
import Layout from "../../components/Layout.astro";
import SectionHead from "../../components/SectionHead.astro";
import { assetHref, findAsset, formatDate, iconMarkup, isEnabled, sortedChangelog, TYPE_LABEL } from "../../lib/assets.ts";
import { searchDocs } from "../../lib/search-index.ts";
import { MODULES } from "../registry.ts";

const docs = new Map(searchDocs().map((d) => [d.id, d]));
const tasks = brand.topTasks
  .map((id) => ({ asset: findAsset(id), doc: docs.get(id) }))
  .filter((t): t is { asset: NonNullable<typeof t.asset>; doc: NonNullable<typeof t.doc> } => !!t.asset && !!t.doc);
const recent = isEnabled("whats-new") ? sortedChangelog().slice(0, 3) : [];
const CHANGE_TAG = { added: "Added", updated: "Updated", retired: "Retired" } as const;
const TASK_ICON: Partial<Record<string, string>> = { font: "type", template: "layout", logo: "logo", "photo-source": "image" };
---

<Layout title={brand.name}>
  <div class="frame page-head">
    <h1 class="title-home">{brand.name}</h1>
    {brand.description && <p class="lead">{brand.description}</p>}
    <button class="search-field" type="button" data-search-open>
      <Icon name="search" />
      <span>Search logos, colors, fonts, and icons</span>
      <kbd class="kbd" aria-hidden="true">/</kbd>
    </button>
  </div>

  {
    tasks.length > 0 && (
      <section class="section frame" aria-labelledby="top-tasks">
        <SectionHead title="Top tasks" id="top-tasks" />
        <div class="grid cards-4">
          {tasks.map(({ asset, doc }) => {
            const [first] = doc.actions;
            return (
              <Card title={asset.label} description={asset.help} href={assetHref(asset)}>
                <Fragment slot="meta">
                  {doc.swatch ? (
                    <span class="swatch-dot" style={`background:${doc.swatch}`} aria-hidden="true" />
                  ) : (
                    <IconTile name={TASK_ICON[asset.type] ?? "grid"} svg={asset.type === "icon" ? iconMarkup(asset) : undefined} />
                  )}
                  <span class="caption">{TYPE_LABEL[asset.type]}</span>
                </Fragment>
                {first && (
                  <Fragment slot="footer">
                    {first.kind === "copy" ? (
                      <button class="btn btn-secondary btn-sm" type="button" data-copy={first.text} data-copy-message={first.message} aria-label={`${first.label}: ${asset.label}`}>
                        <Icon name="copy" size={16} />{first.label}
                      </button>
                    ) : first.kind === "download" ? (
                      <Button size="sm" href={first.href} download={first.filename} icon="download" aria-label={`${first.label}: ${asset.label}`}>{first.label}</Button>
                    ) : (
                      <Button size="sm" href={first.href} external={first.external} aria-label={first.external ? undefined : `${first.label}: ${asset.label}`}>{first.label}</Button>
                    )}
                  </Fragment>
                )}
              </Card>
            );
          })}
        </div>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="section frame" aria-labelledby="recent">
        <SectionHead title="Recent changes" id="recent">
          <Button slot="action" variant="text" href={MODULES["whats-new"].route} iconEnd="arrow-right">All changes</Button>
        </SectionHead>
        <ul class="changelog" role="list">
          {recent.map((e) => {
            const a = findAsset(e.assetId);
            return (
              <ChangelogEntry date={e.date} dateLabel={formatDate(e.date)} tag={CHANGE_TAG[e.change]} title={e.summary} href={a && e.change !== "retired" ? assetHref(a) : undefined} muted={e.change === "retired"} />
            );
          })}
        </ul>
      </section>
    )
  }
</Layout>
