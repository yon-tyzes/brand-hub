---
// One rule: body, do and don't, and the assets it applies to.
import type { GetStaticPaths } from "astro";
import Layout from "../../components/Layout.astro";
import { site } from "../../lib/site-server.ts";
import { PageBody } from "../../site/Page.tsx";
import type { RuleAsset } from "../../../schemas/asset.ts";

export const getStaticPaths = (() => site.rules.map((rule) => ({ params: { id: rule.id }, props: { rule } }))) satisfies GetStaticPaths;

const { rule } = Astro.props as { rule: RuleAsset };
---

<Layout title={rule.title} description={rule.label}>
  <PageBody site={site} page={`rule:${rule.id}`} />
</Layout>
