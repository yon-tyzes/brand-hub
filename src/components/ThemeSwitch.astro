---
// Light/dark switch. State is set by the shell script from <html data-theme>.
import Icon from "./Icon.astro";
---

<button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Dark theme" data-theme-switch>
  <span class="sun"><Icon name="sun" size={16} /></span>
  <span class="moon"><Icon name="moon" size={16} /></span>
</button>
