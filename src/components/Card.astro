---
// Card (docs/DESIGN_SYSTEM.md, "Card"). Slots: preview, meta (a small row above the title), default (body), footer.
// With href, the title link covers the whole card; buttons in the footer stay clickable above it.
interface Props {
  title: string;
  description?: string;
  href?: string;
  id?: string;
  headingLevel?: 2 | 3;
  /** Extra attributes for filtering (e.g. data-filter-values). */
  [key: `data-${string}`]: string | undefined;
}

const { title, description, href, id, headingLevel = 3, ...data } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<article class="card" id={id} {...data}>
  {Astro.slots.has("preview") && <div class="card-preview"><slot name="preview" /></div>}
  {Astro.slots.has("meta") && <div class="row"><slot name="meta" /></div>}
  <Heading class="card-title">{href ? <a class="card-link" href={href}>{title}</a> : title}</Heading>
  {description && <p class="card-description">{description}</p>}
  <slot />
  {Astro.slots.has("footer") && <div class="card-footer above-link"><slot name="footer" /></div>}
</article>
