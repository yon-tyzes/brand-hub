---
// A rule's body and its do and don't lists.
import type { RuleAsset } from "../../schemas/asset.ts";
import { renderMarkdown } from "../lib/markdown.ts";

interface Props {
  rule: RuleAsset;
  /** Heading level for "Do" and "Don't". */
  level?: 2 | 3 | 4;
}

const { rule, level = 3 } = Astro.props;
const H = `h${level}` as "h2" | "h3" | "h4";
---

<div class="stack-lg">
  <div class="prose" set:html={renderMarkdown(rule.body)} />
  {
    (rule.do.length > 0 || rule.dont.length > 0) && (
      <div class="cells-2 do-dont">
        {rule.do.length > 0 && (
          <div>
            <H class="h4">Do</H>
            <ul>{rule.do.map((d) => <li>{d}</li>)}</ul>
          </div>
        )}
        {rule.dont.length > 0 && (
          <div>
            <H class="h4">Don't</H>
            <ul>{rule.dont.map((d) => <li>{d}</li>)}</ul>
          </div>
        )}
      </div>
    )
  }
</div>
