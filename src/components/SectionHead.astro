---
// Section heading with an optional one-line intro and at most one action (slot "action").
interface Props {
  title: string;
  intro?: string;
  id?: string;
}

const { title, intro, id } = Astro.props;
---

<div class="section-head">
  <div>
    <h2 id={id}>{title}</h2>
    {intro && <p class="small">{intro}</p>}
  </div>
  {Astro.slots.has("action") && <slot name="action" />}
</div>
