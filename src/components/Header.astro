---
// Site header (docs/DESIGN_SYSTEM.md, "Header", "Dropdown menu", "Mobile menu", "Theme toggle").
import { brand, modules } from "virtual:brand-hub";
import { assetsOfType, fileUrl, logoFile } from "../lib/assets.ts";
import { ASSET_MODULES } from "../modules/registry.ts";
import Icon from "./Icon.astro";
import IconTile from "./IconTile.astro";
import ThemeSwitch from "./ThemeSwitch.astro";

interface Props {
  path: string;
}

const { path } = Astro.props;
const hasDark = !!brand.tokens.dark;
const assetModules = modules.filter((m) => ASSET_MODULES.includes(m.id));
const otherModules = modules.filter((m) => !ASSET_MODULES.includes(m.id));
const current = (route: string) => (path === route || path.startsWith(`${route}/`) ? "page" : undefined);
// A light-background mark, when the brand has one, sits next to the name.
const mark = assetsOfType("logo").find((l) => l.lockup.toLowerCase() === "mark" && l.background === "light");
const markFile = mark && (logoFile(mark, "svg") ?? logoFile(mark, "png"));
---

<header class="site-header" data-menu-root>
  <div class="header-bar">
    <a class="brand-link" href="/" aria-current={path === "/" ? "page" : undefined}>
      {markFile && <img src={fileUrl(markFile.path)} alt="" width="28" height="28" />}
      <span>{brand.shortName}</span>
    </a>

    <nav class="header-nav" aria-label="Main">
      {
        assetModules.length > 0 && (
          <button class="nav-link" type="button" aria-expanded="false" aria-controls="module-menu" data-menu-trigger>
            Modules <Icon name="chevron-down" size={16} />
          </button>
        )
      }
      {otherModules.map((m) => <a class="nav-link" href={m.route} aria-current={current(m.route)}>{m.label}</a>)}
    </nav>

    <div class="header-tools">
      <button class="btn btn-secondary btn-sm btn-icon header-search" type="button" data-search-open>
        <Icon name="search" />
        <span class="header-search-label">Search</span>
        <kbd class="kbd" aria-hidden="true">Ctrl K</kbd>
      </button>
      {hasDark && <span class="theme-desktop"><ThemeSwitch /></span>}
      <button
        class="btn btn-secondary btn-sm btn-icon menu-button"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-menu-trigger
      >
        <Icon name="menu" />
      </button>
    </div>

    {
      assetModules.length > 0 && (
        <div class="menu-panel" id="module-menu" hidden>
          <ul class="menu-rows" role="list">
            {assetModules.map((m) => (
              <li>
                <a class="menu-row" href={m.route} aria-current={current(m.route)}>
                  <IconTile name={m.icon} />
                  <span>
                    <strong>{m.label}</strong>
                    <small>{m.help}</small>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {otherModules.length > 0 && (
            <div class="menu-links">
              <h2>More</h2>
              <ul class="stack" role="list">
                {otherModules.map((m) => (
                  <li>
                    <a href={m.route}>{m.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )
    }

    <nav class="mobile-menu" id="mobile-menu" aria-label="Main" hidden>
      <ul role="list">
        {
          modules.map((m) => (
            <li>
              <a href={m.route} aria-current={current(m.route)}>
                {m.label}
                <Icon name="arrow-right" />
              </a>
            </li>
          ))
        }
      </ul>
      {
        hasDark && (
          <div class="theme-row">
            <span>Theme</span>
            <ThemeSwitch />
          </div>
        )
      }
    </nav>
  </div>
</header>
