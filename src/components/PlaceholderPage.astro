---
// Page for modules not built yet (start, signature, boilerplate in 0.1) and the admin route.
// Shows only the page name: no copy is invented for missing content.
import Layout from "./Layout.astro";

interface Props {
  title: string;
  noindex?: boolean;
}

const { title, noindex } = Astro.props;
---

<Layout title={title} noindex={noindex}>
  <div class="frame page-head">
    <h1>{title}</h1>
  </div>
</Layout>
