---
// FAQ-style accordion on native <details>, no JS. Pass items, each with a named slot matching its id.
interface Props {
  items: { id: string; title: string }[];
}

const { items } = Astro.props;
const bodies = await Promise.all(items.map((i) => Astro.slots.render(i.id)));
---

<div class="accordion">
  {
    items.map((item, n) => (
      <details id={item.id}>
        <summary>
          <span>{item.title}</span>
          <span class="accordion-toggle" aria-hidden="true" />
        </summary>
        <div class="accordion-body" set:html={bodies[n]} />
      </details>
    ))
  }
</div>
