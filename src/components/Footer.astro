---
// Footer columns (docs/DESIGN_SYSTEM.md, "Footer columns"). Contact and dates come from brand data only.
import { brand, engineVersion, modules } from "virtual:brand-hub";
import { formatDate, sortedChangelog } from "../lib/assets.ts";

const contact = brand.contact;
const lastPublish = sortedChangelog()[0]?.date;
const contactHost = contact?.url ? new URL(contact.url).host : undefined;
---

<footer class="site-footer">
  <div class="frame">
    <div class="footer-top">
      <div class="footer-brand">
        <strong>{brand.name}</strong>
        {brand.description && <p class="small">{brand.description}</p>}
      </div>
      <div class="footer-cols">
        <section class="footer-col" aria-labelledby="footer-modules">
          <h2 id="footer-modules">Brand assets</h2>
          <ul role="list">
            <li><a href="/">Home</a></li>
            {modules.map((m) => <li><a href={m.route}>{m.label}</a></li>)}
          </ul>
        </section>
        {
          (contact?.email || contact?.url) && (
            <section class="footer-col" aria-labelledby="footer-contact">
              <h2 id="footer-contact">Brand contact</h2>
              <ul role="list">
                {contact.email && <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>}
                {contact.url && <li><a href={contact.url}>{contactHost}</a></li>}
              </ul>
            </section>
          )
        }
      </div>
    </div>
    <div class="footer-bottom caption">
      <span>Brand Hub {engineVersion}</span>
      {lastPublish && <span>Last update <time datetime={lastPublish}>{formatDate(lastPublish)}</time></span>}
    </div>
  </div>
</footer>
