{
  "title": "Brand Hub signature.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fields": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n]*$"
          },
          "help": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n]*$"
          },
          "kind": {
            "default": "text",
            "type": "string",
            "enum": [
              "text",
              "email",
              "phone",
              "url"
            ]
          },
          "required": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "designs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\n]*$"
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "headshot": {
            "default": false,
            "type": "boolean"
          },
          "variants": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\n]*$"
                },
                "colors": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "id",
                "label",
                "colors"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "template",
          "fields",
          "variants"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "fields",
    "designs"
  ],
  "additionalProperties": false
}
