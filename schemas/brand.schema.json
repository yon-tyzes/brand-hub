{
  "title": "Brand Hub brand.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "shortName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "color": {
          "type": "object",
          "properties": {
            "bg": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "primary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "link": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "surface2": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "borderStrong": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "onPrimary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "primaryHover": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "focus": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "bg",
            "surface",
            "text",
            "muted",
            "primary",
            "link",
            "border"
          ],
          "additionalProperties": false
        },
        "dark": {
          "type": "object",
          "properties": {
            "bg": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "primary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "link": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "surface2": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "borderStrong": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "onPrimary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "primaryHover": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "focus": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "bg",
            "surface",
            "text",
            "muted",
            "primary",
            "link",
            "border"
          ],
          "additionalProperties": false
        },
        "font": {
          "type": "object",
          "properties": {
            "display": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "displayWeight": {
              "default": 500,
              "anyOf": [
                {
                  "type": "number",
                  "const": 400
                },
                {
                  "type": "number",
                  "const": 500
                },
                {
                  "type": "number",
                  "const": 600
                },
                {
                  "type": "number",
                  "const": 700
                }
              ]
            }
          },
          "required": [
            "display",
            "body"
          ],
          "additionalProperties": false
        },
        "radius": {
          "type": "object",
          "properties": {
            "sm": {
              "type": "number",
              "minimum": 0
            },
            "md": {
              "type": "number",
              "minimum": 0
            },
            "lg": {
              "type": "number",
              "minimum": 0
            },
            "control": {
              "default": 999,
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "sm",
            "md",
            "lg"
          ],
          "additionalProperties": false
        },
        "space": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 9,
          "maxItems": 9
        }
      },
      "required": [
        "color",
        "font",
        "radius",
        "space"
      ],
      "additionalProperties": false
    },
    "naming": {
      "default": {},
      "type": "object",
      "properties": {
        "logo": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "topTasks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "modules": {
      "default": {},
      "type": "object",
      "properties": {
        "icons": {
          "type": "object",
          "properties": {
            "colors": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "name",
    "shortName",
    "tokens"
  ],
  "additionalProperties": false
}
