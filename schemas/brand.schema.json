{
  "title": "Brand Hub brand.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "shortName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "color": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "primary"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "color"
      ],
      "additionalProperties": false
    },
    "naming": {
      "default": {},
      "type": "object",
      "properties": {
        "logo": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "hero": {
      "default": {},
      "type": "object",
      "properties": {
        "tint": {
          "anyOf": [
            {
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "quickDownloads": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "guide": {
      "default": {
        "chapters": []
      },
      "type": "object",
      "properties": {
        "chapters": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "modules": {
      "default": {},
      "type": "object",
      "properties": {
        "icons": {
          "type": "object",
          "properties": {
            "colors": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "name",
    "shortName",
    "tokens"
  ],
  "additionalProperties": false
}
