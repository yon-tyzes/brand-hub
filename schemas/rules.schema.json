{
  "title": "Brand Hub rules.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "label": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\n]*$"
      },
      "help": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\n]*$"
      },
      "status": {
        "type": "string",
        "enum": [
          "locked",
          "pending",
          "draft",
          "retired"
        ]
      },
      "version": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
      },
      "updated": {
        "anyOf": [
          {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        ]
      },
      "audience": {
        "type": "string",
        "enum": [
          "public",
          "internal"
        ]
      },
      "governedBy": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "keywords": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "order": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "type": {
        "type": "string",
        "const": "rule"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "body": {
        "type": "string",
        "minLength": 1
      },
      "do": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "dont": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "appliesTo": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "required": [
      "id",
      "label",
      "status",
      "version",
      "updated",
      "audience",
      "type",
      "title",
      "body"
    ],
    "additionalProperties": false
  }
}
