{
  "name": "@yon-tyzes/brand-hub",
  "version": "0.1.0",
  "description": "Astro engine for brand resource sites with an in-site editor, driven by brand data.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/types.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "schemas",
    "docs",
    "THIRD_PARTY.md"
  ],
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "setup-hooks": "node scripts/setup-hooks.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "schemas": "node scripts/build-schemas.ts",
    "validate": "node scripts/validate-brands.ts",
    "test": "vitest run",
    "check": "node scripts/build-schemas.ts --check && node scripts/validate-brands.ts && node scripts/check-copy.mjs && astro check",
    "test:e2e": "playwright test",
    "test:local": "playwright test --config playwright.local.config.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "minisearch": "^7.2.0",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.1",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@astrojs/react": "^7.1.1",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
